      "type": "choice",
      "parentGroupId": "sectionE",
      "order": 0,
      "number": "E",
      "prompt": {
        "en-US": "If you checked off any problems on this questionnaire, how difficult have these problems made it for you to do your work, take care of things at home, or get along with other people?"
      },
      "required": false,
      "optionSetId": "difficultyFourPoint"
