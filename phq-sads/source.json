      "type": "choice",
      "parentGroupId": "sectionC",
      "order": 4,
      "number": "e",
      "prompt": {
        "en-US": "During your last bad anxiety attack, did you have symptoms like shortness of breath, sweating, or your heart racing, pounding or skipping?"
