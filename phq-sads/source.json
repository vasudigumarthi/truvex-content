      "required": true,
      "optionSetId": "noYes"
    },
    {
      "id": "cD",
      "type": "choice",
      "parentGroupId": "sectionC",
      "order": 3,
      "number": "d",
      "prompt": {
        "en-US": "Do these attacks bother you a lot or are you worried about having another attack?"
