      "type": "choice",
      "parentGroupId": "sectionC",
      "order": 0,
      "number": "a",
      "prompt": {
        "en-US": "In the last 4 weeks, have you had an anxiety attack — suddenly feeling fear or panic?"
      },
      "required": true,
      "optionSetId": "noYes"
    },
    {
      "id": "cB",
      "type": "choice",
      "parentGroupId": "sectionC",
      "order": 1,
      "number": "b",
      "prompt": {
        "en-US": "Has this ever happened before?"
      },
      "required": true,
      "optionSetId": "noYes"
    },
    {
      "id": "cC",
      "type": "choice",
      "parentGroupId": "sectionC",
      "order": 2,
      "number": "c",
      "prompt": {
        "en-US": "Do some of these attacks come suddenly out of the blue — that is, in situations where you don’t expect to be nervous or uncomfortable?"
